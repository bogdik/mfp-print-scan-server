# systemd unit for MFP Print & Scan Server (Linux).
#
# Example install (adjust paths and user — see README, "Running as a service"):
#   sudo cp -r mfp-print-scan-server /opt/mfp-print-scan-server
#   sudo useradd --system --home /opt/mfp-print-scan-server --shell /usr/sbin/nologin mfp
#   for grp in lp scanner; do getent group "$grp" >/dev/null && sudo usermod -aG "$grp" mfp; done
#   sudo chown -R mfp:mfp /opt/mfp-print-scan-server
#   sudo -u mfp /opt/mfp-print-scan-server/start.sh --setup-only
#   sudo cp /opt/mfp-print-scan-server/deploy/mfp-print-scan-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mfp-print-scan-server
#
# Logs:    journalctl -u mfp-print-scan-server -f
# Status:  systemctl status mfp-print-scan-server

[Unit]
Description=MFP Print & Scan Server (web printing and scanning)
Documentation=https://github.com/bogdik/mfp-print-scan-server
# Printing goes through CUPS; start after it and after the network is up.
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=mfp
Group=mfp
# Printer/scanner access: the usermod step above adds mfp to whichever of
# lp/scanner exist on this system, and systemd applies them via User= —
# not listed here as SupplementaryGroups=, since it refuses to even start
# if a listed group doesn't exist (Fedora has no "scanner" group).

WorkingDirectory=/opt/mfp-print-scan-server
ExecStart=/opt/mfp-print-scan-server/.venv/bin/python /opt/mfp-print-scan-server/run.py

# Settings (language, port, sign-in, users...) live in
# /opt/mfp-print-scan-server/config.ini — see README, "Configuration".
# Environment variables override it, e.g.:
#Environment=MFP_PORT=8080
#Environment=MFP_DATA_DIR=/var/lib/mfp-print-scan-server
#Environment=MFP_SCANS_DIR=/var/lib/mfp-print-scan-server/scans

Restart=on-failure
RestartSec=5

# Light hardening: the app only writes to its own folder (data/, scans/, uploads/).
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
