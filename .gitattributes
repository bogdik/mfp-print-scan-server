# Normalize line endings in the repository; check out each file type the way
# its platform needs it, whatever core.autocrlf a contributor has.
* text=auto

# Linux: a CRLF shebang line breaks the script ("bad interpreter").
*.sh      text eol=lf
*.service text eol=lf
*.spec    text eol=lf
packaging/deb/postinst text eol=lf
packaging/deb/prerm    text eol=lf
packaging/deb/postrm   text eol=lf

# Windows: cmd.exe, Windows PowerShell and Inno Setup expect CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

*.png binary
